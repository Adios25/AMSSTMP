# Environment & Secrets Template
# DO NOT commit real secrets (.env is ignored by .gitignore).
# Copy this file to .env and fill in your actual credentials.

# --- 1. Database Configuration ---
# Local Docker Postgres (default): 127.0.0.1:5433
# AWS RDS Postgres: your-db-instance.xxxxxx.us-east-1.rds.amazonaws.com:5432
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# --- 2. Hugging Face Inference API (FinBERT) ---
# Obtain from https://huggingface.co/settings/tokens (Read token)
HF_API_TOKEN=hf_your_token_here

# --- 3. AWS Configuration (Lambda / SNS / Cloud Deployment) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:market-sentiment-alerts

# --- 4. External Market APIs (Optional Real-World Feeds) ---
FINNHUB_API_KEY=your_finnhub_api_key_here
